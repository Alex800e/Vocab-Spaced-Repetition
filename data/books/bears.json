{
 "id": "bears",
 "title": "The Three Bears",
 "titleJa": "3びきのクマ",
 "note": "ゴルディロックスと3びきのクマのお話を、学習用にやさしい英語で書いた再話です。",
 "lines": [
  {
   "en": "Once upon a time, three bears lived in a house in the forest.",
   "ja": "むかしむかし、森の中の家に、3びきのクマが住んでいました。"
  },
  {
   "en": "There was a Father Bear, a Mother Bear, and a Baby Bear.",
   "ja": "お父さんグマと、お母さんグマと、赤ちゃんグマがいました。"
  },
  {
   "en": "One morning, Mother Bear made some porridge for breakfast.",
   "ja": "ある朝、お母さんグマは、朝ごはんにおかゆを作りました。"
  },
  {
   "en": "The porridge was too hot to eat.",
   "ja": "おかゆは熱すぎて、食べられませんでした。"
  },
  {
   "en": "\"Let's go for a walk,\" said Father Bear.",
   "ja": "「散歩に行こう」とお父さんグマは言いました。"
  },
  {
   "en": "The three bears left the house.",
   "ja": "3びきのクマは、家を出ました。"
  },
  {
   "en": "Soon, a little girl named Goldilocks came to the house.",
   "ja": "まもなく、ゴルディロックスという小さな女の子が、その家にやって来ました。"
  },
  {
   "en": "She saw the open door and went in.",
   "ja": "彼女は、開いているドアを見て、中に入りました。"
  },
  {
   "en": "She was hungry, so she tried the porridge.",
   "ja": "彼女はおなかがすいていたので、おかゆをためしに食べてみました。"
  },
  {
   "en": "The big bowl was too hot, and the middle bowl was too cold.",
   "ja": "大きなお皿は熱すぎて、真ん中のお皿は冷たすぎました。"
  },
  {
   "en": "The little bowl was just right, and she ate it all.",
   "ja": "小さなお皿はちょうどよく、彼女は全部食べました。"
  },
  {
   "en": "Then she saw three chairs.",
   "ja": "それから彼女は、3つのいすを見ました。"
  },
  {
   "en": "The big chair was too hard, and the middle chair was too soft.",
   "ja": "大きないすは固すぎて、真ん中のいすはやわらかすぎました。"
  },
  {
   "en": "The little chair was just right, but it broke!",
   "ja": "小さないすはちょうどよかったのですが、こわれてしまいました！"
  },
  {
   "en": "Goldilocks was tired, so she went upstairs.",
   "ja": "ゴルディロックスは疲れていたので、2階へ上がりました。"
  },
  {
   "en": "She found three beds and fell asleep in the little bed.",
   "ja": "彼女は3つのベッドを見つけて、小さなベッドで眠ってしまいました。"
  },
  {
   "en": "The three bears came home.",
   "ja": "3びきのクマが、家に帰ってきました。"
  },
  {
   "en": "\"Someone has eaten my porridge!\" said Baby Bear.",
   "ja": "「だれかがぼくのおかゆを食べた！」と赤ちゃんグマは言いました。"
  },
  {
   "en": "\"Someone has broken my chair!\" he cried.",
   "ja": "「だれかがぼくのいすをこわした！」と彼は叫びました。"
  },
  {
   "en": "They went upstairs and found Goldilocks in the little bed.",
   "ja": "クマたちは2階へ上がり、小さなベッドの中にゴルディロックスを見つけました。"
  },
  {
   "en": "Goldilocks woke up and saw the three bears.",
   "ja": "ゴルディロックスは目をさまして、3びきのクマを見ました。"
  },
  {
   "en": "She jumped out of bed and ran away as fast as she could.",
   "ja": "彼女はベッドから飛び出して、できるだけ速く逃げて行きました。"
  },
  {
   "en": "She never went back to the house of the three bears.",
   "ja": "彼女は二度と、3びきのクマの家には行きませんでした。"
  }
 ],
