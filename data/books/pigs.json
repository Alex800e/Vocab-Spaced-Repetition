{
 "id": "pigs",
 "title": "The Three Little Pigs",
 "titleJa": "3びきのこぶた",
 "note": "昔話「3びきのこぶた」を、学習用にやさしい英語で書いた再話です。",
 "lines": [
  {
   "en": "Once upon a time, there were three little pigs.",
   "ja": "むかしむかし、3びきの小さなこぶたがいました。"
  },
  {
   "en": "One day, they left their mother's house to make their own homes.",
   "ja": "ある日、こぶたたちは、自分たちの家を作るために、お母さんの家を出ました。"
  },
  {
   "en": "The first little pig was lazy.",
   "ja": "1ぴきめの小さなこぶたは、なまけものでした。"
  },
  {
   "en": "He built a house of straw very quickly.",
   "ja": "彼はとても早く、わらの家を建てました。"
  },
  {
   "en": "The second little pig built a house of sticks.",
   "ja": "2ひきめの小さなこぶたは、木の枝の家を建てました。"
  },
  {
   "en": "The third little pig worked hard all day.",
   "ja": "3びきめの小さなこぶたは、一日じゅう一生懸命働きました。"
  },
  {
   "en": "He built a strong house of bricks.",
   "ja": "彼はじょうぶなレンガの家を建てました。"
  },
  {
   "en": "Soon, a big bad wolf came walking down the road.",
   "ja": "まもなく、大きな悪いオオカミが、道を歩いてやって来ました。"
  },
  {
   "en": "The wolf was very hungry.",
   "ja": "オオカミはとてもおなかがすいていました。"
  },
  {
   "en": "He knocked on the door of the straw house.",
   "ja": "彼はわらの家のドアをノックしました。"
  },
  {
   "en": "\"Little pig, little pig, let me come in!\" said the wolf.",
   "ja": "「こぶた、こぶた、中に入れておくれ！」とオオカミは言いました。"
  },
  {
   "en": "\"No, no, not by the hair of my chinny chin chin!\" said the first pig.",
   "ja": "「いやだ、いやだ、ぼくのあごひげにかけて、入れるもんか！」と1ぴきめのこぶたは言いました。"
  },
  {
   "en": "\"Then I'll huff, and I'll puff, and I'll blow your house down!\"",
   "ja": "「それなら、ふーふー息をふいて、おまえの家を吹き飛ばしてやる！」"
  },
  {
   "en": "The wolf huffed and puffed, and he blew the straw house down.",
   "ja": "オオカミはふーふー息をふいて、わらの家を吹き飛ばしました。"
  },
  {
   "en": "The first pig ran away to his brother's house of sticks.",
   "ja": "1ぴきめのこぶたは、兄弟の木の枝の家へ逃げて行きました。"
  },
  {
   "en": "The wolf came to the house of sticks.",
   "ja": "オオカミは木の枝の家に来ました。"
  },
  {
   "en": "He huffed and puffed, and he blew the house of sticks down, too.",
   "ja": "ふーふー息をふいて、木の枝の家も吹き飛ばしました。"
  },
  {
   "en": "The two little pigs ran to the brick house as fast as they could.",
   "ja": "2ひきのこぶたは、できるだけ速く、レンガの家へ走りました。"
  },
  {
   "en": "Their brother let them in and locked the door.",
   "ja": "きょうだいは2ひきを中に入れて、ドアにかぎをかけました。"
  },
  {
   "en": "The wolf came to the brick house.",
   "ja": "オオカミはレンガの家に来ました。"
  },
  {
   "en": "He huffed and puffed, but the strong house did not fall down.",
   "ja": "ふーふー息をふきましたが、じょうぶな家はたおれませんでした。"
  },
  {
   "en": "The wolf was very angry.",
   "ja": "オオカミはとても怒りました。"
  },
  {
   "en": "\"I will climb up on the roof and come down the chimney,\" he thought.",
   "ja": "「屋根にのぼって、えんとつから下りてやろう」と彼は考えました。"
  },
  {
   "en": "The clever pigs heard the wolf on the roof.",
   "ja": "かしこいこぶたたちは、屋根の上のオオカミの音を聞きました。"
  },
  {
   "en": "They put a big pot of hot water in the fireplace.",
   "ja": "こぶたたちは、暖炉に熱いお湯の入った大きなおなべを置きました。"
  },
  {
   "en": "The wolf fell into the pot with a loud splash!",
   "ja": "オオカミは大きな水しぶきをあげて、おなべの中に落ちました。"
  },
  {
   "en": "He jumped out and ran away, and he never came back.",
   "ja": "彼は飛び出して逃げて行き、二度と戻ってきませんでした。"
  },
  {
   "en": "The three little pigs lived happily ever after.",
   "ja": "3びきの小さなこぶたは、その後ずっとしあわせにくらしました。"
  }
 ],
