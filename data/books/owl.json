{
 "id": "owl",
 "title": "The Owl and the Pussy-Cat",
 "titleJa": "フクロウとねこ",
 "note": "フクロウとねこが海へ旅に出るお話を、学習用にやさしい英語で書いた再話です。",
 "lines": [
  {
   "en": "Once upon a time, an owl and a cat became good friends.",
   "ja": "むかしむかし、フクロウとねこが、仲よしになりました。"
  },
  {
   "en": "One night, they went to sea in a beautiful green boat.",
   "ja": "ある夜、二人は、きれいな緑色の船で、海へ出かけました。"
  },
  {
   "en": "They took some honey and a lot of money with them.",
   "ja": "二人は、はちみつと、たくさんのお金を持って行きました。"
  },
  {
   "en": "The owl played a small guitar under the stars.",
   "ja": "フクロウは、星空の下で、小さなギターをひきました。"
  },
  {
   "en": "\"Oh, lovely cat, how beautiful you are!\" he sang.",
   "ja": "「ああ、すてきなねこさん、きみはなんて美しいんだ！」と彼は歌いました。"
  },
  {
   "en": "\"You are a lovely bird,\" said the cat.",
   "ja": "「あなたは、すてきな鳥さんね」とねこは言いました。"
  },
  {
   "en": "\"Let us get married,\" said the owl.",
   "ja": "「結婚しましょう」とフクロウは言いました。"
  },
  {
   "en": "\"But we have no ring,\" said the cat.",
   "ja": "「でも、指輪がないわ」とねこは言いました。"
  },
  {
   "en": "So they sailed away for a year and a day.",
   "ja": "そこで、二人は、1年と1日のあいだ、船で旅をしました。"
  },
  {
   "en": "They came to a land where a pig lived in the wood.",
   "ja": "二人は、森にぶたが住んでいる土地にたどり着きました。"
  },
  {
   "en": "The pig had a ring on the end of his nose.",
   "ja": "ぶたは、鼻の先に指輪をつけていました。"
  },
  {
   "en": "\"Will you sell me your ring?\" asked the owl.",
   "ja": "「その指輪を売ってくれませんか？」とフクロウはたずねました。"
  },
  {
   "en": "\"Yes,\" said the pig. \"You may buy it for one coin.\"",
   "ja": "「いいよ」とぶたは言いました。「1まいのコインで買えるよ」"
  },
  {
   "en": "The next day, they were married by a wise turkey.",
   "ja": "つぎの日、二人は、かしこい七面鳥に結婚させてもらいました。"
  },
  {
   "en": "They ate a nice dinner of fish and cake.",
   "ja": "二人は、魚とケーキのおいしい夕食を食べました。"
  },
  {
   "en": "They ate with a spoon.",
   "ja": "二人は、スプーンで食べました。"
  },
  {
   "en": "Then they danced in the light of the moon.",
   "ja": "それから二人は、月の光の中でおどりました。"
  },
  {
   "en": "They danced and danced all night long.",
   "ja": "二人は、夜どおし、おどりつづけました。"
  },
  {
   "en": "The owl and the cat were very happy.",
   "ja": "フクロウとねこは、とてもしあわせでした。"
  }
 ],
